FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Core system deps
RUN apt-get update && apt-get install -y \
    apt-transport-https \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    software-properties-common \
    sudo \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CE (needed for Dokku / DinD)
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu jammy stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y docker-ce docker-ce-cli containerd.io && \
    rm -rf /var/lib/apt/lists/*

# Install Dokku — the postinstall script calls systemctl which doesn't work
# in Docker, so we temporarily shim it with a no-op and remove after
RUN wget -NP /tmp https://packagecloud.io/dokku/dokku/gpgkey && \
    apt-key add /tmp/gpgkey && \
    echo "deb https://packagecloud.io/dokku/dokku/ubuntu/ jammy main" > /etc/apt/sources.list.d/dokku.list && \
    apt-get update && \
    mv /usr/bin/systemctl /usr/bin/systemctl.real || true && \
    printf '#!/bin/sh\nexit 0\n' > /usr/bin/systemctl && chmod +x /usr/bin/systemctl && \
    apt-get install -y dokku || true && \
    mv /usr/bin/systemctl.real /usr/bin/systemctl || rm -f /usr/bin/systemctl && \
    # Mark packages with failed postinstall as installed so future apt calls work
    sed -i 's/^Status: install ok half-configured$/Status: install ok installed/' /var/lib/dpkg/status && \
    rm -rf /var/lib/apt/lists/*

# Clone Dokku plugins (postgres, mariadb, redis, dokkufile) without running
# install hooks — the hooks need Docker which isn't available during build.
# Plugin install hooks will run at container start when Docker is up.
RUN git clone https://github.com/dokku/dokku-postgres.git /var/lib/dokku/plugins/available/postgres && \
    dokku plugin:enable postgres && \
    git clone https://github.com/dokku/dokku-mariadb.git /var/lib/dokku/plugins/available/mariadb && \
    dokku plugin:enable mariadb && \
    git clone https://github.com/dokku/dokku-redis.git /var/lib/dokku/plugins/available/redis && \
    dokku plugin:enable redis && \
    git clone https://github.com/deanmarano/dokkufile.git /var/lib/dokku/plugins/available/dokkufile && \
    dokku plugin:enable dokkufile || true

# Install yq v4.44.1
RUN wget -qO /usr/local/bin/yq https://github.com/mikefarah/yq/releases/download/v4.44.1/yq_linux_amd64 && \
    chmod +x /usr/local/bin/yq

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Pre-install npm dependencies
COPY package.json package-lock.json /npm-cache/
RUN cd /npm-cache && npm ci

# Install Playwright Chromium + system deps
RUN cd /npm-cache && npx playwright install --with-deps chromium

# Clean up
RUN apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/*
