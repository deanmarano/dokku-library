#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

app_name="$1"

if [[ -z "$app_name" ]]; then
  echo "!     Usage: dokku library:info <app-name>" >&2
  exit 1
fi

# Check library first
manifest_path="$PLUGIN_BASE_PATH/library/$app_name/manifest.json"
if [[ -f "$manifest_path" ]]; then
  manifest="$(load_manifest "$app_name")"
  description="$(get_manifest_field "$manifest" '.description')"
  image="$(get_manifest_field "$manifest" '.image')"
  url="$(get_manifest_field "$manifest" '.url // "N/A"')"

  echo "=====> Library App: $app_name"
  echo "       Description:  $description"
  echo "       Image:        $image"
  echo "       Website:      $url"

  # Show required plugins
  echo "       Plugins:"
  for plugin in postgres mariadb letsencrypt dokku-mail dokku-auth; do
    required="$(get_manifest_field "$manifest" ".plugins[\"$plugin\"].required // false")"
    default="$(get_manifest_field "$manifest" ".plugins[\"$plugin\"].default // false")"
    if [[ "$required" == "true" ]]; then
      echo "         $plugin (required)"
    elif [[ "$default" == "true" ]]; then
      echo "         $plugin (optional, enabled by default)"
    fi
  done
fi

# Show installed state if applicable
if is_app_installed "$app_name"; then
  echo ""
  echo "       Installation Status: INSTALLED"
  echo "       Domain:       $(get_app_state "$app_name" "DOMAIN")"
  echo "       Image:        $(get_app_state "$app_name" "IMAGE")"
  echo "       Installed at: $(get_app_state "$app_name" "CHECKED_OUT_AT")"

  # Show linked plugins
  echo "       Linked plugins:"
  if [[ -d "$PLUGIN_DATA_ROOT/apps/$app_name/plugins" ]]; then
    for plugin_file in "$PLUGIN_DATA_ROOT/apps/$app_name/plugins"/*; do
      if [[ -f "$plugin_file" ]]; then
        plugin_name="$(basename "$plugin_file")"
        plugin_value="$(cat "$plugin_file")"
        echo "         $plugin_name: $plugin_value"
      fi
    done
  fi

  # Show running status
  running="$(dokku_cmd ps:report "$app_name" --running 2>/dev/null || echo "unknown")"
  if [[ "$running" == "true" ]]; then
    echo "       Running:      yes"
  else
    echo "       Running:      no"
  fi
elif [[ ! -f "$manifest_path" ]]; then
  echo "!     App '$app_name' not found in library" >&2
  exit 1
else
  echo ""
  echo "       Installation Status: NOT INSTALLED"
fi
