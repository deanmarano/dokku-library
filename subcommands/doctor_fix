#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

app_name="$1"

if [[ -z "$app_name" ]]; then
  echo "!     Usage: dokku library:doctor:fix <app-name>" >&2
  exit 1
fi

if ! is_app_installed "$app_name"; then
  echo "!     App '$app_name' is not installed via library" >&2
  exit 1
fi

fixed_count=0

echo "-----> Fixing $app_name"

# Re-apply saved dokkufile if available
saved_yaml="$(get_app_state "$app_name" "DOKKUFILE")"
if [[ -n "$saved_yaml" ]] && check_plugin_available "dokkufile"; then
  tmpfile="$(mktemp /tmp/dokkufile-XXXXXX.yml)"
  echo "$saved_yaml" >"$tmpfile"

  echo "       [FIX] Running dokkufile apply"
  dokku_cmd dokkufile:apply -f "$tmpfile" || true
  rm -f "$tmpfile"
  ((++fixed_count))
else
  # Fallback for apps installed before dokkufile migration
  manifest_name="$(get_app_state "$app_name" "MANIFEST_NAME")"
  manifest="$(load_manifest "$manifest_name")"

  # Check app exists
  if ! dokku_cmd apps:exists "$app_name" 2>/dev/null; then
    echo "       [FIX] Creating app $app_name"
    dokku_cmd apps:create "$app_name"
    ((++fixed_count))
  fi

  # Check domain
  expected_domain="$(get_app_state "$app_name" "DOMAIN")"
  actual_domains="$(dokku_cmd domains:report "$app_name" --domains-app-vhosts 2>/dev/null || echo "")"
  if ! echo "$actual_domains" | grep -q "$expected_domain"; then
    echo "       [FIX] Setting domain: $expected_domain"
    dokku_cmd domains:set "$app_name" "$expected_domain"
    ((++fixed_count))
  fi

  # Check image and redeploy if needed
  expected_image="$(get_app_state "$app_name" "IMAGE")"
  actual_image="$(dokku_cmd git:report "$app_name" --git-source-image 2>/dev/null || echo "")"
  if [[ -n "$expected_image" && "$actual_image" != *"$expected_image"* ]]; then
    echo "       [FIX] Redeploying with image: $expected_image"
    dokku_cmd git:from-image "$app_name" "$expected_image"
    ((++fixed_count))
  fi
fi

# Check letsencrypt
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/letsencrypt" ]]; then
  ssl_enabled="$(dokku_cmd letsencrypt:active "$app_name" 2>/dev/null && echo "yes" || echo "no")"
  if [[ "$ssl_enabled" != "yes" ]]; then
    echo "       [FIX] Enabling Let's Encrypt"
    dokku_cmd letsencrypt:enable "$app_name" || echo "       Warning: letsencrypt setup failed"
    ((++fixed_count))
  fi
fi

# Check running
running="$(dokku_cmd ps:report "$app_name" --running 2>/dev/null || echo "false")"
if [[ "$running" != "true" ]]; then
  echo "       [FIX] Starting app"
  dokku_cmd ps:start "$app_name"
  ((++fixed_count))
fi

if [[ "$fixed_count" -gt 0 ]]; then
  echo ""
  echo "       Fixed $fixed_count issue(s)"
else
  echo ""
  echo "       No issues found, everything looks good!"
fi
