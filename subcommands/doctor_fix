#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

app_name="$1"

if [[ -z "$app_name" ]]; then
  echo "!     Usage: dokku library:doctor:fix <app-name>" >&2
  exit 1
fi

if ! is_app_installed "$app_name"; then
  echo "!     App '$app_name' is not installed via library" >&2
  exit 1
fi

manifest_name="$(get_app_state "$app_name" "MANIFEST_NAME")"
manifest="$(load_manifest "$manifest_name")"
fixed_count=0

echo "-----> Fixing $app_name"

# Check app exists
if ! "$DOKKU_BIN" apps:exists "$app_name" 2>/dev/null; then
  echo "       [FIX] Creating app $app_name"
  "$DOKKU_BIN" apps:create "$app_name"
  ((fixed_count++))
fi

# Check domain
expected_domain="$(get_app_state "$app_name" "DOMAIN")"
actual_domains="$("$DOKKU_BIN" domains:report "$app_name" --domains-app-vhosts 2>/dev/null || echo "")"
if ! echo "$actual_domains" | grep -q "$expected_domain"; then
  echo "       [FIX] Setting domain: $expected_domain"
  "$DOKKU_BIN" domains:set "$app_name" "$expected_domain"
  ((fixed_count++))
fi

# Check proxy ports
expected_ports="$(get_manifest_field "$manifest" '.proxy.ports // empty')"
if [[ -n "$expected_ports" ]]; then
  actual_ports="$("$DOKKU_BIN" ports:report "$app_name" --ports-map 2>/dev/null || echo "")"
  if ! echo "$actual_ports" | grep -q "$(echo "$expected_ports" | tr ' ' '\n' | head -1)"; then
    echo "       [FIX] Setting proxy ports: $expected_ports"
    "$DOKKU_BIN" ports:set "$app_name" "$expected_ports"
    ((fixed_count++))
  fi
fi

# Check environment variables
env_keys="$(get_manifest_field "$manifest" '.env | keys[]' 2>/dev/null || true)"
if [[ -n "$env_keys" ]]; then
  env_fix_args=""
  while IFS= read -r key; do
    expected_value="$(get_app_state "$app_name" "env/$key")"
    actual_value="$("$DOKKU_BIN" config:get "$app_name" "$key" 2>/dev/null || echo "")"

    if [[ -z "$expected_value" ]]; then
      continue
    fi

    if [[ "$actual_value" != "$expected_value" ]]; then
      echo "       [FIX] Setting env: $key"
      env_fix_args="$env_fix_args $key=$expected_value"
      ((fixed_count++))
    fi
  done <<<"$env_keys"

  if [[ -n "$env_fix_args" ]]; then
    # shellcheck disable=SC2086
    "$DOKKU_BIN" config:set --no-restart "$app_name" $env_fix_args
  fi
fi

# Check postgres
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/postgres" ]]; then
  db_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/postgres")"
  if ! "$DOKKU_BIN" postgres:exists "$db_service" 2>/dev/null; then
    echo "       [FIX] Creating postgres service: $db_service"
    "$DOKKU_BIN" postgres:create "$db_service"
    ((fixed_count++))
  fi
  linked="$("$DOKKU_BIN" postgres:linked "$db_service" "$app_name" 2>/dev/null && echo "yes" || echo "no")"
  if [[ "$linked" != "yes" ]]; then
    echo "       [FIX] Linking postgres: $db_service"
    "$DOKKU_BIN" postgres:link "$db_service" "$app_name" || true
    ((fixed_count++))
  fi
fi

# Check letsencrypt
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/letsencrypt" ]]; then
  ssl_enabled="$("$DOKKU_BIN" letsencrypt:active "$app_name" 2>/dev/null && echo "yes" || echo "no")"
  if [[ "$ssl_enabled" != "yes" ]]; then
    echo "       [FIX] Enabling Let's Encrypt"
    "$DOKKU_BIN" letsencrypt:enable "$app_name" || echo "       Warning: letsencrypt setup failed"
    ((fixed_count++))
  fi
fi

# Check image and redeploy if needed
expected_image="$(get_app_state "$app_name" "IMAGE")"
actual_image="$("$DOKKU_BIN" git:report "$app_name" --git-deploy-source 2>/dev/null || echo "")"
if [[ -n "$expected_image" && "$actual_image" != *"$expected_image"* ]]; then
  echo "       [FIX] Redeploying with image: $expected_image"
  "$DOKKU_BIN" git:from-image "$app_name" "$expected_image"
  ((fixed_count++))
fi

# Check running
running="$("$DOKKU_BIN" ps:report "$app_name" --ps-running 2>/dev/null || echo "false")"
if [[ "$running" != "true" ]]; then
  echo "       [FIX] Starting app"
  "$DOKKU_BIN" ps:start "$app_name"
  ((fixed_count++))
fi

if [[ "$fixed_count" -gt 0 ]]; then
  echo ""
  echo "       Fixed $fixed_count issue(s)"
else
  echo ""
  echo "       No issues found, everything looks good!"
fi
