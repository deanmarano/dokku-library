#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

app_name="$1"

if [[ -z "$app_name" ]]; then
  echo "!     Usage: dokku library:stop <app-name>" >&2
  exit 1
fi

if ! is_app_installed "$app_name"; then
  echo "!     App '$app_name' is not installed via library" >&2
  exit 1
fi

echo "-----> Stopping $app_name"
dokku_cmd ps:stop "$app_name"
echo "       $app_name stopped"
