#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

app_name="$1"
shift || true

if [[ -z "$app_name" ]]; then
  echo "!     Usage: dokku library:cleanup <app-name> [--force]" >&2
  exit 1
fi

force=false
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
  esac
done

if ! is_app_installed "$app_name"; then
  echo "!     App '$app_name' is not installed via library" >&2
  exit 1
fi

if [[ "$force" != "true" ]]; then
  read -r -p "       Are you sure you want to remove $app_name and all its data? [y/N]: " confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "       Cancelled"
    exit 0
  fi
fi

echo "-----> Cleaning up $app_name"

# Run pre-cleanup hook if it exists
manifest_name="$(get_app_state "$app_name" "MANIFEST_NAME")"
if [[ -n "$manifest_name" ]]; then
  pre_cleanup_script="$PLUGIN_BASE_PATH/library/$manifest_name/pre-cleanup.sh"
  if [[ -f "$pre_cleanup_script" ]]; then
    echo "-----> Running pre-cleanup hook"
    # shellcheck source=/dev/null
    source "$pre_cleanup_script"
  fi
fi

# Stop app
echo "       Stopping app"
dokku_cmd ps:stop "$app_name" 2>/dev/null || true

# Unlink and destroy postgres
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/postgres" ]]; then
  db_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/postgres")"
  echo "       Removing PostgreSQL: $db_service"
  dokku_cmd postgres:unlink "$db_service" "$app_name" 2>/dev/null || true
  dokku_cmd postgres:destroy "$db_service" -f 2>/dev/null || true
fi

# Unlink and destroy mariadb
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/mariadb" ]]; then
  db_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/mariadb")"
  echo "       Removing MariaDB: $db_service"
  dokku_cmd mariadb:unlink "$db_service" "$app_name" 2>/dev/null || true
  dokku_cmd mariadb:destroy "$db_service" -f 2>/dev/null || true
fi

# Unlink and destroy redis
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/redis" ]]; then
  redis_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/redis")"
  echo "       Removing Redis: $redis_service"
  dokku_cmd redis:unlink "$redis_service" "$app_name" 2>/dev/null || true
  dokku_cmd redis:destroy "$redis_service" -f 2>/dev/null || true
fi

# Unlink mail
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-mail" ]]; then
  mail_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-mail")"
  echo "       Removing mail: $mail_service"
  dokku_cmd mail:unlink "$mail_service" "$app_name" 2>/dev/null || true
  dokku_cmd mail:destroy "$mail_service" -f 2>/dev/null || true
fi

# Unlink and unprotect auth
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-sso" ]]; then
  auth_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-sso")"
  echo "       Removing sso: $auth_service"
  if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-sso-oidc-client" ]]; then
    # OIDC integration — tear down client + env vars
    dokku_cmd sso:oidc:teardown "$auth_service" "$app_name" 2>/dev/null || true
  else
    dokku_cmd sso:unprotect "$app_name" 2>/dev/null || true
  fi
  if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-sso-linked" ]]; then
    dokku_cmd sso:unlink "$auth_service" "$app_name" 2>/dev/null || true
  fi
fi

# Disable letsencrypt
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/letsencrypt" ]]; then
  echo "       Disabling Let's Encrypt"
  dokku_cmd letsencrypt:disable "$app_name" 2>/dev/null || true
fi

# Destroy app
echo "       Destroying app"
dokku_cmd apps:destroy "$app_name" --force

# Remove state directory
echo "       Removing state"
rm -rf "${PLUGIN_DATA_ROOT:?}/apps/${app_name:?}"

echo "=====> $app_name cleaned up successfully"
