#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

app_name="$1"
shift || true

if [[ -z "$app_name" ]]; then
  echo "!     Usage: dokku library:cleanup <app-name> [--force]" >&2
  exit 1
fi

force=false
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
  esac
done

if ! is_app_installed "$app_name"; then
  echo "!     App '$app_name' is not installed via library" >&2
  exit 1
fi

if [[ "$force" != "true" ]]; then
  read -r -p "       Are you sure you want to remove $app_name and all its data? [y/N]: " confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "       Cancelled"
    exit 0
  fi
fi

echo "-----> Cleaning up $app_name"

# Stop app
echo "       Stopping app"
"$DOKKU_BIN" ps:stop "$app_name" 2>/dev/null || true

# Unlink and destroy postgres
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/postgres" ]]; then
  db_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/postgres")"
  echo "       Removing PostgreSQL: $db_service"
  "$DOKKU_BIN" postgres:unlink "$db_service" "$app_name" 2>/dev/null || true
  "$DOKKU_BIN" postgres:destroy "$db_service" -f 2>/dev/null || true
fi

# Unlink mail
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-mail" ]]; then
  mail_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-mail")"
  echo "       Removing mail: $mail_service"
  "$DOKKU_BIN" mail:unlink "$mail_service" "$app_name" 2>/dev/null || true
  "$DOKKU_BIN" mail:destroy "$mail_service" -f 2>/dev/null || true
fi

# Unlink and unprotect auth
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-auth" ]]; then
  auth_service="$(cat "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/dokku-auth")"
  echo "       Removing auth: $auth_service"
  "$DOKKU_BIN" auth:unprotect "$app_name" 2>/dev/null || true
  "$DOKKU_BIN" auth:unlink "$auth_service" "$app_name" 2>/dev/null || true
fi

# Disable letsencrypt
if [[ -f "$PLUGIN_DATA_ROOT/apps/$app_name/plugins/letsencrypt" ]]; then
  echo "       Disabling Let's Encrypt"
  "$DOKKU_BIN" letsencrypt:disable "$app_name" 2>/dev/null || true
fi

# Destroy app
echo "       Destroying app"
"$DOKKU_BIN" apps:destroy "$app_name" --force

# Remove state directory
echo "       Removing state"
rm -rf "${PLUGIN_DATA_ROOT:?}/apps/${app_name:?}"

echo "=====> $app_name cleaned up successfully"
