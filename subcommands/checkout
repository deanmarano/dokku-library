#!/usr/bin/env bash
set -eo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

library_app="$1"
shift || true

if [[ -z "$library_app" ]]; then
  echo "!     Usage: dokku library:checkout <app-name> [options]" >&2
  echo "       Options:" >&2
  echo "         --name=<name>         Custom app name (default: manifest name)" >&2
  echo "         --domain=<domain>     Custom domain" >&2
  echo "         --no-ssl              Skip letsencrypt" >&2
  echo "         --no-mail             Skip mail setup" >&2
  echo "         --no-auth             Skip auth setup" >&2
  echo "         --auth-service=<name> Auth service to use" >&2
  echo "         --non-interactive     Use defaults, no prompts" >&2
  exit 1
fi

# Parse options
custom_domain=""
custom_name=""
no_ssl=false
no_mail=false
no_auth=false
auth_service=""
non_interactive=false

for arg in "$@"; do
  case "$arg" in
    --name=*) custom_name="${arg#--name=}" ;;
    --domain=*) custom_domain="${arg#--domain=}" ;;
    --no-ssl) no_ssl=true ;;
    --no-mail) no_mail=true ;;
    --no-auth) no_auth=true ;;
    --auth-service=*) auth_service="${arg#--auth-service=}" ;;
    --non-interactive) non_interactive=true ;;
  esac
done

# App name can differ from library manifest name
app_name="${custom_name:-$library_app}"

# Load manifest
manifest="$(load_manifest "$library_app")"

# Check if already installed
if is_app_installed "$app_name"; then
  echo "!     App '$app_name' is already installed. Use library:cleanup first." >&2
  exit 1
fi

# Extract manifest fields
image="$(get_manifest_field "$manifest" '.image')"
description="$(get_manifest_field "$manifest" '.description')"

echo "=====> Installing $app_name ($description)"
echo "       Image: $image"

# Resolve prompts
declare -A prompt_values

# Process prompts from manifest
prompt_count="$(get_manifest_field "$manifest" '.prompts | length')"
for ((i = 0; i < prompt_count; i++)); do
  key="$(get_manifest_field "$manifest" ".prompts[$i].key")"
  question="$(get_manifest_field "$manifest" ".prompts[$i].question")"
  default="$(get_manifest_field "$manifest" ".prompts[$i].default")"

  # Resolve default value
  default="$(resolve_domain "$app_name" "$default")"

  # Check if value was passed via --domain flag
  if [[ "$key" == "DOMAIN" && -n "$custom_domain" ]]; then
    prompt_values[$key]="$custom_domain"
    echo "       $key: $custom_domain"
  elif [[ "$non_interactive" == "true" ]]; then
    prompt_values[$key]="$default"
    echo "       $key: $default (default)"
  else
    read -r -p "       $question [$default]: " user_input
    prompt_values[$key]="${user_input:-$default}"
  fi
done

domain="${prompt_values[DOMAIN]:-$app_name.$(hostname -f 2>/dev/null || hostname)}"

# Generate a secret for env var substitution
secret="$(generate_secret 32)"

# Create the dokku app
echo "-----> Creating app $app_name"
dokku_cmd apps:create "$app_name"

# Set up plugins
echo "-----> Configuring plugins"

# Postgres
postgres_required="$(get_manifest_field "$manifest" '.plugins.postgres.required // false')"
postgres_default="$(get_manifest_field "$manifest" '.plugins.postgres.default // false')"
if [[ "$postgres_required" == "true" || "$postgres_default" == "true" ]]; then
  if check_plugin_available "postgres"; then
    db_service="${app_name}-db"
    echo "       Setting up PostgreSQL: $db_service"
    dokku_cmd postgres:create "$db_service" || true
    dokku_cmd postgres:link "$db_service" "$app_name" || true
    set_app_state "$app_name" "plugins/postgres" "$db_service"

    # If the manifest specifies a connection_env, copy DATABASE_URL to that env var
    # (e.g. Ghost/Knex needs database__connection instead of DATABASE_URL)
    connection_env="$(get_manifest_field "$manifest" '.plugins.postgres.connection_env // empty')"
    if [[ -n "$connection_env" ]]; then
      db_url="$(dokku_cmd config:get "$app_name" "DATABASE_URL" 2>/dev/null || echo "")"
      if [[ -n "$db_url" ]]; then
        echo "       Setting $connection_env from DATABASE_URL"
        dokku_cmd config:set --no-restart "$app_name" "$connection_env=$db_url"
      fi
    fi
  else
    if [[ "$postgres_required" == "true" ]]; then
      echo "!     PostgreSQL plugin required but not installed" >&2
      dokku_cmd apps:destroy "$app_name" --force
      exit 1
    fi
    echo "       PostgreSQL plugin not available, skipping"
  fi
fi

# MariaDB
mariadb_required="$(get_manifest_field "$manifest" '.plugins.mariadb.required // false')"
mariadb_default="$(get_manifest_field "$manifest" '.plugins.mariadb.default // false')"
if [[ "$mariadb_required" == "true" || "$mariadb_default" == "true" ]]; then
  if check_plugin_available "mariadb"; then
    db_service="${app_name}-db"
    echo "       Setting up MariaDB: $db_service"
    dokku_cmd mariadb:create "$db_service" || true
    dokku_cmd mariadb:link "$db_service" "$app_name" || true
    set_app_state "$app_name" "plugins/mariadb" "$db_service"

    # If the manifest specifies a connection_env, copy DATABASE_URL to that env var
    connection_env="$(get_manifest_field "$manifest" '.plugins.mariadb.connection_env // empty')"
    if [[ -n "$connection_env" ]]; then
      db_url="$(dokku_cmd config:get "$app_name" "DATABASE_URL" 2>/dev/null || echo "")"
      if [[ -n "$db_url" ]]; then
        echo "       Setting $connection_env from DATABASE_URL"
        dokku_cmd config:set --no-restart "$app_name" "$connection_env=$db_url"
      fi
    fi
  else
    if [[ "$mariadb_required" == "true" ]]; then
      echo "!     MariaDB plugin required but not installed" >&2
      dokku_cmd apps:destroy "$app_name" --force
      exit 1
    fi
    echo "       MariaDB plugin not available, skipping"
  fi
fi

# Set environment variables
echo "-----> Setting environment variables"
env_keys="$(get_manifest_field "$manifest" '.env | keys[]' 2>/dev/null || true)"
env_args=""
if [[ -n "$env_keys" ]]; then
  while IFS= read -r key; do
    value="$(get_manifest_field "$manifest" ".env[\"$key\"]")"
    value="$(resolve_env_value "$value" "$domain" "$app_name" "$secret")"
    env_args="$env_args $key=$value"
    set_app_state "$app_name" "env/$key" "$value"
  done <<<"$env_keys"

  if [[ -n "$env_args" ]]; then
    # shellcheck disable=SC2086
    dokku_cmd config:set --no-restart "$app_name" $env_args
  fi
fi

# Set domain
echo "-----> Setting domain: $domain"
dokku_cmd domains:set "$app_name" "$domain"

# Set up storage mounts
storage_count="$(get_manifest_field "$manifest" '.storage | length' 2>/dev/null || echo 0)"
if [[ "$storage_count" -gt 0 ]]; then
  echo "-----> Setting up storage mounts"
  for ((i = 0; i < storage_count; i++)); do
    mount="$(get_manifest_field "$manifest" ".storage[$i]")"
    host_path="$(echo "$mount" | cut -d: -f1)"
    host_path="${host_path//%APP_NAME%/$app_name}"
    container_path="$(echo "$mount" | cut -d: -f2)"
    mkdir -p "$host_path"
    dokku_cmd storage:mount "$app_name" "${host_path}:${container_path}"
  done
fi

# Set docker options
for phase in deploy run; do
  options="$(get_manifest_field "$manifest" ".docker_options.$phase // empty")"
  if [[ -n "$options" ]]; then
    echo "-----> Setting docker options for $phase"
    dokku_cmd docker-options:add "$app_name" "$phase" "$options"
  fi
done

# Set proxy ports before deploy so the initial deployment uses the correct port mapping
proxy_ports="$(get_manifest_field "$manifest" '.proxy.ports // empty')"
if [[ -n "$proxy_ports" ]]; then
  echo "-----> Setting proxy ports: $proxy_ports"
  dokku_cmd ports:set "$app_name" "$proxy_ports"
fi

# Build custom image if Dockerfile exists (e.g. to add database drivers)
dockerfile_path="$PLUGIN_BASE_PATH/library/$library_app/Dockerfile"
if [[ -f "$dockerfile_path" ]]; then
  custom_tag="dokku-library/${library_app}:latest"
  echo "-----> Building custom image $custom_tag"
  docker build -t "$custom_tag" "$(dirname "$dockerfile_path")"
  image="$custom_tag"
fi

# Deploy from image
echo "-----> Deploying $app_name from image $image"
dokku_cmd git:from-image "$app_name" "$image"

# Run post-deploy commands
post_deploy_count="$(get_manifest_field "$manifest" '.setup.post_deploy | length' 2>/dev/null || echo 0)"
if [[ "$post_deploy_count" -gt 0 ]]; then
  echo "-----> Running post-deploy commands"
  for ((i = 0; i < post_deploy_count; i++)); do
    cmd="$(get_manifest_field "$manifest" ".setup.post_deploy[$i]")"
    echo "       Running: $cmd"
    # shellcheck disable=SC2086
    dokku_cmd run "$app_name" $cmd
  done
fi

# Letsencrypt (must be after deploy)
le_default="$(get_manifest_field "$manifest" '.plugins.letsencrypt.default // false')"
if [[ "$le_default" == "true" && "$no_ssl" != "true" ]]; then
  if check_plugin_available "letsencrypt"; then
    echo "-----> Enabling Let's Encrypt SSL"
    dokku_cmd letsencrypt:enable "$app_name" || echo "       Warning: letsencrypt setup failed, continuing without SSL"
    set_app_state "$app_name" "plugins/letsencrypt" "enabled"
  else
    echo "       Let's Encrypt plugin not available, skipping SSL"
  fi
fi

# Mail
mail_default="$(get_manifest_field "$manifest" '.plugins["dokku-mail"].default // false')"
if [[ "$mail_default" == "true" && "$no_mail" != "true" ]]; then
  if check_plugin_available "dokku-mail"; then
    mail_service="${app_name}-mail"
    echo "-----> Setting up mail: $mail_service"
    dokku_cmd mail:create "$mail_service" || true
    dokku_cmd mail:link "$mail_service" "$app_name" || true
    set_app_state "$app_name" "plugins/dokku-mail" "$mail_service"
  else
    echo "       Mail plugin not available, skipping"
  fi
fi

# Auth (dokku-auth: LDAP directory link + Authelia forward auth)
auth_default="$(get_manifest_field "$manifest" '.plugins["dokku-auth"].default // false')"
if [[ "$auth_default" == "true" && "$no_auth" != "true" ]]; then
  if check_plugin_available "dokku-auth"; then
    # Determine which auth service to use
    AUTH_SERVICE="${auth_service:-}"
    if [[ -z "$AUTH_SERVICE" ]]; then
      # Look for a default auth directory service
      AUTH_SERVICE="$(dokku_cmd auth:list 2>/dev/null | head -1 || true)"
    fi
    if [[ -n "$AUTH_SERVICE" ]]; then
      echo "-----> Linking auth service: $AUTH_SERVICE"
      dokku_cmd auth:link "$AUTH_SERVICE" "$app_name" || true
      echo "-----> Protecting app with Authelia forward auth"
      dokku_cmd auth:protect "$app_name" || true
      set_app_state "$app_name" "plugins/dokku-auth" "$AUTH_SERVICE"
    else
      echo "       No auth service found, skipping auth setup"
    fi
  else
    echo "       Auth plugin not available, skipping"
  fi
fi

# Save state
echo "-----> Saving installation state"
set_app_state "$app_name" "MANIFEST_NAME" "$library_app"
set_app_state "$app_name" "DOMAIN" "$domain"
set_app_state "$app_name" "IMAGE" "$image"
set_app_state "$app_name" "CHECKED_OUT_AT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Save prompt values
for key in "${!prompt_values[@]}"; do
  set_app_state "$app_name" "config/$key" "${prompt_values[$key]}"
done

echo "=====> $app_name deployed successfully!"
echo "       URL: https://$domain"
