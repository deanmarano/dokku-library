#!/usr/bin/env bash
set -eo pipefail
# shellcheck source=config
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/functions"

# Skip command name when called via dokku subcommand auto-discovery
[[ "${1:-}" == "library:"* ]] && shift

library_app="$1"
shift || true

if [[ -z "$library_app" ]]; then
  echo "!     Usage: dokku library:checkout <app-name> [options]" >&2
  echo "       Options:" >&2
  echo "         --name=<name>         Custom app name (default: manifest name)" >&2
  echo "         --domain=<domain>     Custom domain" >&2
  echo "         --no-ssl              Skip letsencrypt" >&2
  echo "         --no-dns              Skip DNS setup" >&2
  echo "         --no-mail             Skip mail setup" >&2
  echo "         --no-auth             Skip auth setup" >&2
  echo "         --auth-service=<name> Auth service to use" >&2
  echo "         --non-interactive     Use defaults, no prompts" >&2
  exit 1
fi

# Parse options
custom_domain=""
custom_name=""
no_ssl=false
no_dns=false
no_mail=false
no_auth=false
auth_service=""
non_interactive=false

for arg in "$@"; do
  case "$arg" in
    --name=*) custom_name="${arg#--name=}" ;;
    --domain=*) custom_domain="${arg#--domain=}" ;;
    --no-ssl) no_ssl=true ;;
    --no-dns) no_dns=true ;;
    --no-mail) no_mail=true ;;
    --no-auth) no_auth=true ;;
    --auth-service=*) auth_service="${arg#--auth-service=}" ;;
    --non-interactive) non_interactive=true ;;
  esac
done

# App name can differ from library manifest name
app_name="${custom_name:-$library_app}"

# Load manifest
manifest="$(load_manifest "$library_app")"

# Ensure requirements are installed first
passthrough_flags=()
[[ "$no_ssl" == "true" ]] && passthrough_flags+=("--no-ssl")
[[ "$no_dns" == "true" ]] && passthrough_flags+=("--no-dns")
[[ "$no_mail" == "true" ]] && passthrough_flags+=("--no-mail")
[[ "$no_auth" == "true" ]] && passthrough_flags+=("--no-auth")
[[ -n "$auth_service" ]] && passthrough_flags+=("--auth-service=$auth_service")
ensure_requirements "$manifest" "${passthrough_flags[@]}"

# Check if already installed (re-checkout mode)
recheckout=false
if is_app_installed "$app_name"; then
  recheckout=true
fi

# Extract manifest fields
description="$(get_manifest_field "$manifest" '.library.description')"
# Get the app key name from the manifest (first key under apps:)
manifest_app_name="$(get_manifest_field "$manifest" '.apps | keys | .[0]')"
image="$(get_manifest_field "$manifest" ".apps.\"$manifest_app_name\".image")"

if [[ "$recheckout" == "true" ]]; then
  echo "=====> Re-checking out $app_name ($description)"
else
  echo "=====> Installing $app_name ($description)"
fi
echo "       Image: $image"

# Resolve prompts
declare -A prompt_values

# Process prompts from manifest
prompt_count="$(get_manifest_field "$manifest" '.library.prompts | length')"
for ((i = 0; i < prompt_count; i++)); do
  key="$(get_manifest_field "$manifest" ".library.prompts[$i].key")"
  question="$(get_manifest_field "$manifest" ".library.prompts[$i].question")"
  default="$(get_manifest_field "$manifest" ".library.prompts[$i].default")"

  # On re-checkout, use previously saved value as default
  if [[ "$recheckout" == "true" ]]; then
    saved_value="$(get_app_state "$app_name" "config/$key")"
    if [[ -n "$saved_value" ]]; then
      default="$saved_value"
    else
      default="$(resolve_domain "$app_name" "$default")"
    fi
  else
    # Resolve default value
    default="$(resolve_domain "$app_name" "$default")"
  fi

  # Check if value was passed via --domain flag
  if [[ "$key" == "DOMAIN" && -n "$custom_domain" ]]; then
    prompt_values[$key]="$custom_domain"
    echo "       $key: $custom_domain"
  elif [[ "$non_interactive" == "true" ]]; then
    prompt_values[$key]="$default"
    echo "       $key: $default (default)"
  else
    read -r -p "       $question [$default]: " user_input
    prompt_values[$key]="${user_input:-$default}"
  fi
done

domain="${prompt_values[DOMAIN]:-$app_name.$(hostname -f 2>/dev/null || hostname)}"

# Generate secrets for template substitution
if [[ "$recheckout" == "true" ]]; then
  # Reuse existing secrets to avoid breaking running apps
  saved_dokkufile="$(get_app_state "$app_name" "DOKKUFILE")"
  secret="$(echo "$saved_dokkufile" | yq eval ".apps.\"$app_name\".env.SECRET // \"\"" - 2>/dev/null || true)"
  secret_base64="$(echo "$saved_dokkufile" | yq eval ".apps.\"$app_name\".env.SECRET_BASE64_32 // \"\"" - 2>/dev/null || true)"
  # Fall back to generating new ones if not found (legacy installs)
  if [[ -z "$secret" ]]; then
    secret="$(generate_secret 32)"
  fi
  if [[ -z "$secret_base64" ]]; then
    secret_base64="$(generate_secret_base64 32)"
  fi
else
  secret="$(generate_secret 32)"
  secret_base64="$(generate_secret_base64 32)"
fi

# Generate resolved dokkufile YAML
echo "-----> Generating dokkufile"
resolved_yaml="$(resolve_dokkufile_yaml "$manifest" "$app_name" "$manifest_app_name" "$domain" "$secret" "$secret_base64" "$no_ssl" "$no_dns")"

# Create storage directories before dokkufile apply
storage_count="$(echo "$resolved_yaml" | yq eval ".apps.\"$app_name\".storage | length" - 2>/dev/null || echo 0)"
if [[ "$storage_count" -gt 0 ]]; then
  echo "-----> Creating storage directories"
  for ((i = 0; i < storage_count; i++)); do
    mount="$(echo "$resolved_yaml" | yq eval ".apps.\"$app_name\".storage[$i]" -)"
    host_path="$(echo "$mount" | cut -d: -f1)"
    mkdir -p "$host_path"
  done
fi

# Run pre-apply hook if it exists (seeds config files before first deploy)
pre_apply_script="$PLUGIN_BASE_PATH/library/$library_app/pre-apply.sh"
if [[ -f "$pre_apply_script" ]]; then
  echo "-----> Running pre-apply hook"
  # shellcheck source=/dev/null
  source "$pre_apply_script"
fi

# Write resolved YAML to temp file
tmpfile="$(mktemp /tmp/dokkufile-XXXXXX.yml)"
trap 'rm -f "$tmpfile"' EXIT
echo "$resolved_yaml" >"$tmpfile"

# Check if connection_env post-processing will be needed.
# If so, the initial deploy may fail healthchecks because the app starts
# without its database/redis connection vars. We tolerate that and rebuild after.
has_connection_env="$(get_manifest_field "$manifest" '.library.connection_env.mode // ""')"

# On re-checkout, check if connection env vars are already configured
skip_connection_env=false
if [[ "$recheckout" == "true" && -n "$has_connection_env" ]]; then
  service_type="$(get_manifest_field "$manifest" '.library.connection_env.type // ""')"
  url_var="DATABASE_URL"
  if [[ "$service_type" == "redis" ]]; then
    url_var="REDIS_URL"
  fi
  existing_url="$(dokku_cmd config:get "$app_name" "$url_var" 2>/dev/null || true)"
  if [[ -n "$existing_url" ]]; then
    skip_connection_env=true
  fi
fi

# Run dokkufile apply
echo "-----> Applying dokkufile"
apply_failed=false
if [[ -n "$has_connection_env" && "$skip_connection_env" != "true" ]]; then
  # Deploy may fail healthchecks — connection env vars are set post-apply
  dokku_cmd dokkufile:apply -f "$tmpfile" || apply_failed=true
else
  dokku_cmd dokkufile:apply -f "$tmpfile"
fi

# Post-processing: connection_env
echo "-----> Post-processing"
if [[ "$skip_connection_env" == "true" ]]; then
  echo "       Connection environment already configured, skipping"
else
  post_process_connection_env "$app_name" "$manifest"
fi

# If connection_env was set (and not skipped), redeploy/restart to pick up the new env vars
if [[ -n "$has_connection_env" && "$skip_connection_env" != "true" ]]; then
  if [[ "$apply_failed" == "true" ]]; then
    # Initial deploy failed (healthcheck failed without connection env vars).
    # ps:rebuild won't work because git:from-image didn't store a commit.
    # Re-run git:from-image now that env vars are set.
    echo "-----> Redeploying $app_name with connection environment"
    dokku_cmd git:from-image "$app_name" "$image"
  else
    # Initial deploy succeeded. Just restart to pick up new env vars.
    echo "-----> Restarting $app_name with connection environment"
    dokku_cmd ps:restart "$app_name"
  fi
fi

# Post-processing: mail
mail_service_name=""
# Check if manifest has services that use mail (library-level concept)
if [[ "$no_mail" != "true" ]]; then
  if check_plugin_available "dokku-mail"; then
    mail_service_name="${app_name}-mail"
    echo "       Setting up mail: $mail_service_name"
    dokku_cmd mail:create "$mail_service_name" || true
    dokku_cmd mail:link "$mail_service_name" "$app_name" || true
    set_app_state "$app_name" "plugins/dokku-mail" "$mail_service_name"
  fi
fi

# Post-processing: auth
if [[ "$no_auth" != "true" ]]; then
  if check_plugin_available "sso"; then
    AUTH_SERVICE="${auth_service:-}"
    if [[ -z "$AUTH_SERVICE" ]]; then
      AUTH_SERVICE="$(dokku_cmd sso:list 2>/dev/null | grep -v '====>' | awk '{print $1}' | head -1 || true)"
    fi
    if [[ -n "$AUTH_SERVICE" ]]; then
      # Only sso:link (LDAP) if the manifest explicitly requests it
      sso_link="$(get_manifest_field "$manifest" ".apps.\"$manifest_app_name\".sso_link // false" 2>/dev/null || echo "false")"
      if [[ "$sso_link" == "true" ]]; then
        echo "       Linking LDAP service: $AUTH_SERVICE"
        dokku_cmd sso:link "$AUTH_SERVICE" "$app_name" || true
        set_app_state "$app_name" "plugins/dokku-sso-linked" "true"
      fi

      echo "       Protecting app with Authelia forward auth"
      dokku_cmd sso:protect "$app_name" || true
      set_app_state "$app_name" "plugins/dokku-sso" "$AUTH_SERVICE"

      # Apply app-specific SSO env vars (e.g. auth proxy headers) if defined
      sso_env_keys="$(get_manifest_field "$manifest" ".apps.\"$manifest_app_name\".sso_env | keys | .[]" 2>/dev/null || true)"
      if [[ -n "$sso_env_keys" ]]; then
        echo "       Setting SSO environment variables"
        while IFS= read -r key; do
          val="$(get_manifest_field "$manifest" ".apps.\"$manifest_app_name\".sso_env.\"$key\"")"
          dokku_cmd config:set --no-restart "$app_name" "$key=$val"
        done <<<"$sso_env_keys"
      fi
    else
      echo "       No auth service found, skipping auth setup"
    fi
  fi
fi

# Save state
echo "-----> Saving installation state"
set_app_state "$app_name" "MANIFEST_NAME" "$library_app"
set_app_state "$app_name" "DOMAIN" "$domain"
set_app_state "$app_name" "IMAGE" "$image"
set_app_state "$app_name" "CHECKED_OUT_AT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
set_app_state "$app_name" "DOKKUFILE" "$resolved_yaml"

# Save plugin state for services (used by cleanup)
service_names="$(echo "$resolved_yaml" | yq eval '.services | keys | .[]' - 2>/dev/null || true)"
if [[ -n "$service_names" ]]; then
  while IFS= read -r svc_name; do
    svc_type="$(echo "$resolved_yaml" | yq eval ".services.\"$svc_name\".type" -)"
    set_app_state "$app_name" "plugins/$svc_type" "$svc_name"
  done <<<"$service_names"
fi

# Save prompt values
for key in "${!prompt_values[@]}"; do
  set_app_state "$app_name" "config/$key" "${prompt_values[$key]}"
done

# Run post-checkout hook if it exists
post_checkout_script="$PLUGIN_BASE_PATH/library/$library_app/post-checkout.sh"
if [[ -f "$post_checkout_script" ]]; then
  echo "-----> Running post-checkout hook"
  # shellcheck source=/dev/null
  source "$post_checkout_script"
fi

# On re-checkout, stop+start to pick up any env var changes from post-processing.
# We use stop+start instead of restart because restart does a rolling deploy
# (starts new container before stopping old), which fails for apps that hold
# exclusive file locks (e.g. Prometheus TSDB).
if [[ "$recheckout" == "true" ]]; then
  echo "-----> Restarting $app_name to apply changes"
  dokku_cmd ps:stop "$app_name"
  dokku_cmd ps:start "$app_name"
  echo "=====> $app_name re-checked out successfully!"
else
  echo "=====> $app_name deployed successfully!"
fi
echo "       URL: https://$domain"
