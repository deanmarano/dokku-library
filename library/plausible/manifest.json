{
  "name": "plausible",
  "description": "Privacy-friendly web analytics",
  "image": "ghcr.io/plausible/community-edition:v2",
  "url": "https://plausible.io",
  "plugins": {
    "postgres": { "required": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "BASE_URL": "http://%DOMAIN%",
    "SECRET_KEY_BASE": "%SECRET%",
    "TOTP_VAULT_KEY": "%SECRET_BASE64_32%",
    "DISABLE_REGISTRATION": "invite_only"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Plausible",
      "default": "plausible.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 8000
  },
  "proxy": {
    "ports": "http:80:8000"
  },
  "healthcheck": {
    "path": "/",
    "timeout": 90
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [],
  "docker_options": {}
}
