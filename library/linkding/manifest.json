{
  "name": "linkding",
  "description": "Self-hosted bookmark manager",
  "image": "sissbruecker/linkding:latest",
  "url": "https://github.com/sissbruecker/linkding",
  "plugins": {
    "postgres": { "required": false, "default": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "LD_DB_ENGINE": "postgres",
    "LD_SERVER_PORT": "9090",
    "LD_SUPERUSER_NAME": "admin",
    "LD_SUPERUSER_PASSWORD": "%SECRET%"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Linkding",
      "default": "linkding.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 9090
  },
  "proxy": {
    "ports": "http:80:9090"
  },
  "healthcheck": {
    "path": "/health",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [],
  "docker_options": {}
}
