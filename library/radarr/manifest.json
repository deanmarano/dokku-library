{
  "name": "radarr",
  "description": "Movie collection manager for Usenet and BitTorrent",
  "image": "lscr.io/linuxserver/radarr:latest",
  "url": "https://radarr.video",
  "plugins": {
    "letsencrypt": { "required": false, "default": true },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "Etc/UTC"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Radarr",
      "default": "radarr.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 7878
  },
  "proxy": {
    "ports": "http:80:7878"
  },
  "healthcheck": {
    "path": "/",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/radarr-%APP_NAME%-config:/config",
    "/var/lib/dokku/data/storage/radarr-%APP_NAME%-movies:/movies",
    "/var/lib/dokku/data/storage/radarr-%APP_NAME%-downloads:/downloads"
  ],
  "docker_options": {}
}
