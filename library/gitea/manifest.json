{
  "name": "gitea",
  "description": "Lightweight self-hosted Git service",
  "image": "gitea/gitea:latest",
  "url": "https://gitea.io",
  "plugins": {
    "postgres": { "required": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true, "integration": "oidc" }
  },
  "env": {
    "GITEA__database__DB_TYPE": "postgres",
    "GITEA__server__DOMAIN": "%DOMAIN%",
    "GITEA__server__ROOT_URL": "https://%DOMAIN%/",
    "GITEA__server__SSH_DOMAIN": "%DOMAIN%",
    "GITEA__security__SECRET_KEY": "%SECRET%",
    "GITEA__security__INTERNAL_TOKEN": "%SECRET%"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Gitea",
      "default": "gitea.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 3000
  },
  "proxy": {
    "ports": "http:80:3000"
  },
  "healthcheck": {
    "path": "/",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/gitea-%APP_NAME%:/data"
  ],
  "docker_options": {}
}
