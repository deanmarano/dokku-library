{
  "name": "nextcloud",
  "description": "Self-hosted file sync and collaboration platform",
  "image": "nextcloud:stable",
  "url": "https://nextcloud.com",
  "plugins": {
    "postgres": { "required": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": true },
    "dokku-auth": { "required": false, "default": true, "integration": "ldap" }
  },
  "env": {
    "POSTGRES_HOST": "",
    "NEXTCLOUD_ADMIN_USER": "admin",
    "NEXTCLOUD_ADMIN_PASSWORD": "%SECRET%",
    "NEXTCLOUD_TRUSTED_DOMAINS": "%DOMAIN%",
    "OVERWRITEPROTOCOL": "https",
    "OVERWRITEHOST": "%DOMAIN%"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Nextcloud",
      "default": "nextcloud.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 80
  },
  "proxy": {
    "ports": "http:80:80"
  },
  "healthcheck": {
    "path": "/status.php",
    "timeout": 120
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/nextcloud-%APP_NAME%:/var/www/html"
  ],
  "docker_options": {}
}
