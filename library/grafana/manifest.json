{
  "name": "grafana",
  "description": "Open-source monitoring and observability platform",
  "image": "grafana/grafana:latest",
  "url": "https://grafana.com",
  "plugins": {
    "postgres": { "required": false, "default": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true, "integration": "oidc" }
  },
  "env": {
    "GF_SERVER_ROOT_URL": "https://%DOMAIN%",
    "GF_DATABASE_TYPE": "postgres",
    "GF_SECURITY_ADMIN_PASSWORD": "%SECRET%"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Grafana",
      "default": "grafana.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 3000
  },
  "proxy": {
    "ports": "http:80:3000"
  },
  "healthcheck": {
    "path": "/api/health",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [],
  "docker_options": {}
}
