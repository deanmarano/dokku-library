{
  "name": "bookstack",
  "description": "Simple and free wiki software",
  "image": "lscr.io/linuxserver/bookstack:latest",
  "url": "https://www.bookstackapp.com",
  "plugins": {
    "postgres": { "required": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": true },
    "dokku-auth": { "required": false, "default": true, "integration": "ldap" }
  },
  "env": {
    "APP_URL": "https://%DOMAIN%",
    "DB_CONNECTION": "pgsql",
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "Etc/UTC"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for BookStack",
      "default": "bookstack.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 80
  },
  "proxy": {
    "ports": "http:80:80"
  },
  "healthcheck": {
    "path": "/login",
    "timeout": 90
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/bookstack-%APP_NAME%:/config"
  ],
  "docker_options": {}
}
