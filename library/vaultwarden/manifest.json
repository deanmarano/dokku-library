{
  "name": "vaultwarden",
  "description": "Lightweight Bitwarden-compatible password manager",
  "image": "vaultwarden/server:latest",
  "url": "https://github.com/dani-garcia/vaultwarden",
  "plugins": {
    "postgres": { "required": false, "default": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "DOMAIN": "http://%DOMAIN%",
    "SIGNUPS_ALLOWED": "false",
    "ADMIN_TOKEN": "%SECRET%",
    "ROCKET_PORT": "8080"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Vaultwarden",
      "default": "vaultwarden.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 8080
  },
  "proxy": {
    "ports": "http:80:8080"
  },
  "healthcheck": {
    "path": "/alive",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/vaultwarden-%APP_NAME%:/data"
  ],
  "docker_options": {}
}
