{
  "name": "sonarr",
  "description": "TV series collection manager for Usenet and BitTorrent",
  "image": "lscr.io/linuxserver/sonarr:latest",
  "url": "https://sonarr.tv",
  "plugins": {
    "letsencrypt": { "required": false, "default": true },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "Etc/UTC"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Sonarr",
      "default": "sonarr.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 8989
  },
  "proxy": {
    "ports": "http:80:8989"
  },
  "healthcheck": {
    "path": "/",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/sonarr-%APP_NAME%-config:/config",
    "/var/lib/dokku/data/storage/sonarr-%APP_NAME%-tv:/tv",
    "/var/lib/dokku/data/storage/sonarr-%APP_NAME%-downloads:/downloads"
  ],
  "docker_options": {}
}
