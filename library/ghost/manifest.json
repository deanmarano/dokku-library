{
  "name": "ghost",
  "description": "Professional publishing platform",
  "image": "ghost:5-alpine",
  "url": "https://ghost.org",
  "plugins": {
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": true },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "NODE_ENV": "production",
    "url": "https://%DOMAIN%",
    "database__client": "sqlite3",
    "database__connection__filename": "/var/lib/ghost/content/data/ghost.db"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Ghost",
      "default": "ghost.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 2368
  },
  "proxy": {
    "ports": "http:80:2368"
  },
  "healthcheck": {
    "path": "/",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [],
  "docker_options": {}
}
