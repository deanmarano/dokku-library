{
  "name": "mealie",
  "description": "Self-hosted recipe manager and meal planner",
  "image": "ghcr.io/mealie-recipes/mealie:latest",
  "url": "https://mealie.io",
  "plugins": {
    "postgres": { "required": false, "default": true, "connection_env": "POSTGRES_URL_OVERRIDE" },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true, "integration": "oidc" }
  },
  "env": {
    "BASE_URL": "http://%DOMAIN%",
    "DB_ENGINE": "postgres",
    "ALLOW_SIGNUP": "false",
    "TZ": "Etc/UTC",
    "MAX_WORKERS": "1",
    "WEB_CONCURRENCY": "1"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Mealie",
      "default": "mealie.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 9000
  },
  "proxy": {
    "ports": "http:80:9000"
  },
  "healthcheck": {
    "path": "/api/app/about",
    "timeout": 60
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/mealie-%APP_NAME%:/app/data"
  ],
  "docker_options": {}
}
