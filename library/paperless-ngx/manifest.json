{
  "name": "paperless-ngx",
  "description": "Document management system with OCR",
  "image": "ghcr.io/paperless-ngx/paperless-ngx:latest",
  "url": "https://docs.paperless-ngx.com",
  "plugins": {
    "postgres": { "required": true },
    "letsencrypt": { "required": false, "default": true },
    "dokku-mail": { "required": false, "default": false },
    "dokku-auth": { "required": false, "default": true }
  },
  "env": {
    "PAPERLESS_URL": "http://%DOMAIN%",
    "PAPERLESS_SECRET_KEY": "%SECRET%",
    "PAPERLESS_ADMIN_USER": "admin",
    "PAPERLESS_ADMIN_PASSWORD": "%SECRET%",
    "PAPERLESS_OCR_LANGUAGE": "eng",
    "PAPERLESS_TIME_ZONE": "Etc/UTC"
  },
  "prompts": [
    {
      "key": "DOMAIN",
      "question": "Domain for Paperless-ngx",
      "default": "paperless.%HOSTNAME%",
      "env_var": null
    }
  ],
  "ports": {
    "http": 8000
  },
  "proxy": {
    "ports": "http:80:8000"
  },
  "healthcheck": {
    "path": "/",
    "timeout": 120
  },
  "setup": {
    "post_deploy": []
  },
  "storage": [
    "/var/lib/dokku/data/storage/paperless-%APP_NAME%-data:/usr/src/paperless/data",
    "/var/lib/dokku/data/storage/paperless-%APP_NAME%-media:/usr/src/paperless/media",
    "/var/lib/dokku/data/storage/paperless-%APP_NAME%-consume:/usr/src/paperless/consume",
    "/var/lib/dokku/data/storage/paperless-%APP_NAME%-export:/usr/src/paperless/export"
  ],
  "docker_options": {},
  "scheduler": {
    "init_process": false
  }
}
